{
  "expo": {
    "name": "Pyme Maps",
    "slug": "pyme-maps",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "userInterfaceStyle": "light",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "La app necesita acceso a tus fotos para subir imágenes de tu negocio y productos",
        "NSCameraUsageDescription": "La app necesita acceso a la cámara para tomar fotos de tu negocio y productos",
        "NSLocationWhenInUseUsageDescription": "Necesitamos tu ubicación para mostrarte locales cercanos en el mapa",
        "UIUserInterfaceStyle": "Light"
      }
    },
    "android": {
      "userInterfaceStyle": "light",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "READ_MEDIA_IMAGES",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBbR55Tn_tBaJN2-FmfuNS-Q6tbjtv4ikI"
        }
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "La app necesita acceso a tus fotos para subir imágenes de tu negocio y productos",
          "cameraPermission": "La app necesita acceso a la cámara para tomar fotos de tu negocio y productos"
        }
      ]
    ],
    "extra": {
      "googleApiKey": "AIzaSyBbR55Tn_tBaJN2-FmfuNS-Q6tbjtv4ikI"
    }
  }
}