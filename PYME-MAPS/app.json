{
  "expo": {
    "name": "PYME-MAPS",
    "slug": "PYME-MAPS",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "La app necesita acceso a tus fotos para subir imágenes de tu negocio y productos",
        "NSCameraUsageDescription": "La app necesita acceso a la cámara para tomar fotos de tu negocio y productos",
        "NSLocationWhenInUseUsageDescription": "Necesitamos tu ubicación para mostrarte locales cercanos en el mapa"
      }
    },
    "android": {
      "package": "com.tuusuario.tuapp",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBbR55Tn_tBaJN2-FmfuNS-Q6tbjtv4ikI"
        }
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "La app necesita acceso a tus fotos para subir imágenes de tu negocio y productos",
          "cameraPermission": "La app necesita acceso a la cámara para tomar fotos de tu negocio y productos"
        }
      ]
    ],
    "extra": {
      "googleApiKey": "AIzaSyBbR55Tn_tBaJN2-FmfuNS-Q6tbjtv4ikI",
      "eas": {
        "projectId": "28c8b2ad-57a0-47a2-a810-12bbc122f6f4"
      }
    }
  }
}
